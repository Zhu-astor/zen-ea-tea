}

/* Trust section cards: uniform height */
#shopify-section-zen-trust .js-fadetarget {
  min-height: 160px;
  display: flex !important;
  flex-direction: column;
  justify-content: center;
}

/* Fix mobile horizontal overflow on subpages - header elements */
@media (max-width: 768px) {
  body { overflow-x: hidden !important; }
  .c-header__inner, .c-header-top, .c-unav-pc { max-width: 100% !important; overflow-x: hidden !important; }
  .c-gnav-pc { display: none !important; }
  .c-unav-pc { display: none !important; }
  .page-width { max-width: 100% !important; padding: 0 15px !important; }
  .p-sub-page, .p-product-detail { overflow-x: hidden !important; }
  table { max-width: 100% !important; display: block !important; overflow-x: auto !important; }
}

/* PC nav dropdown thumbnails (關於蟬吃茶 / 茶品知識 / 蟬茶日誌 mega-menus): main--
   global.css sets .c-img-nav--pc{width:150px;height:100%}. "height:100%" only resolves
   against a definite-height ancestor; the containing <li>/<a> here has no set height,
   so browsers fall back to the image's own natural aspect ratio for height instead —
   each of the 6 dropdown thumbnails uses a differently-shaped source (a ~65x65 icon, a
   2215x898 landscape banner, several ~800x800-ish product/article photos), so they
   rendered at wildly different heights side by side (confirmed by screenshot: one near-
   square icon next to a short landscape sliver next to a much taller photo). Forcing a
   fixed aspect-ratio + object-fit:cover makes every thumbnail resolve to the same box
   regardless of its source image's shape, matching the width:150/height:190 the HTML
   attributes already specify (a ~0.79 ratio) but which the CSS never actually enforced. */
.c-img-nav--pc {
  height: auto !important;
  aspect-ratio: 150 / 190 !important;
  object-fit: cover !important;
  object-position: center !important;
}

/* 購物 (Shopping) dropdown's own thumbnail class has no height rule at all (pure
   natural-aspect-ratio auto height) — our 4 source images are all similar-ish
   landscape banners so this happened to look "close enough", but nothing actually
   constrains it; same fix as .c-img-nav--pc above for consistency/robustness. */
.c-img-nav-category {
  height: auto !important;
  aspect-ratio: 1 / 1 !important;
  object-fit: cover !important;
  object-position: center !important;
}

/* Fix remaining mobile overflow */
@media (max-width: 768px) {
  html, body { overflow-x: hidden !important; max-width: 100vw !important; }
  * { max-width: 100% !important; }
  .c-unav-pc, .c-gnav-pc { display: none !important; }
  .c-header-top > ul:not(.c-unav-sp-fix) { display: none !important; }
  .announcement-bar__message { font-size: 12px !important; padding: 8px 10px !important; }
}
